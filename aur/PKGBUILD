# Template rendered by .github/workflows/aur.yml: @PKGVER@ is replaced
# with the tag version and sha256sums are filled by updpkgsums in CI.
pkgname=snowcone
pkgver=@PKGVER@
pkgrel=1
pkgdesc="One package manager to rule them all - a unified CLI/TUI over every package manager on the system."
arch=('x86_64')
url="https://github.com/nickheyer/snowcone"
license=('custom')
depends=('gcc-libs')
makedepends=('cargo')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/nickheyer/snowcone/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${pkgname}-${pkgver}"
  cargo build --release --locked -p snowcone
}

package() {
  cd "${pkgname}-${pkgver}"
  install -Dm755 target/release/snow "${pkgdir}/usr/bin/snow"
}
